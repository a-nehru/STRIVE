{
  "name": "physio-galenus-backend",
  "version": "0.4.1+build20240703T182718.119",
  "description": "Backend for Physio Galenus Therapist",
  "author": "",
  "engines": {
    "node": "14.18.2"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build --webpack && cp package.production.json dist/package.json && cp -R .platform .npmrc Procfile ecosystem.config.js replace-env-vars-in-ecosystem.sh ../../CHANGELOG.md src/api/routines/adjust-difficulty/main.r dist/ && cd dist/ && zip -r application.zip .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_ENV=testing jest --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=testing jest --watch",
    "test:cov": "cross-env NODE_ENV=testing jest --coverage",
    "test:debug": "cross-env NODE_ENV=testing node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=testing jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config ./src/config/database.config.ts",
    "db:schema:sync": "cross-env DATABASE_HOST=localhost npm run typeorm -- schema:sync",
    "db:schema:drop": "cross-env DATABASE_HOST=localhost npm run typeorm -- schema:drop",
    "compodoc": "npx compodoc -p tsconfig.doc.json --serve --port 8083",
    "db:migration:generate": "cross-env DATABASE_HOST=localhost NODE_ENV=development npm run typeorm -- migration:generate -n",
    "db:migration:create": "cross-env DATABASE_HOST=localhost NODE_ENV=development npm run typeorm -- migration:create -n",
    "db:migration:run": "cross-env DATABASE_HOST=localhost NODE_ENV=development npm run typeorm -- migration:run",
    "db:migration:revert": "cross-env DATABASE_HOST=localhost NODE_ENV=development npm run typeorm -- migration:revert",
    "prepare": "cd ../.. && husky install sources/backend/.husky"
  },
  "dependencies": {
    "@nestjs/common": "^7.6.15",
    "@nestjs/core": "^7.6.15",
    "@nestjs/passport": "^8.0.0",
    "@nestjs/platform-express": "^7.6.15",
    "@nestjs/swagger": "^4.8.2",
    "@nestjs/typeorm": "^7.1.5",
    "@types/express-session": "^1.17.4",
    "@types/faker": "^5.5.9",
    "aws-sdk": "^2.1148.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.2",
    "colors": "^1.4.0",
    "connect-typeorm": "^1.1.4",
    "date-fns": "^2.27.0",
    "express-session": "^1.17.2",
    "faker": "^5.5.3",
    "helmet": "^4.6.0",
    "lint-staged": "^11.1.2",
    "lodash": "^4.17.21",
    "logform": "^2.2.0",
    "nest-emitter": "^1.1.1",
    "nest-winston": "^1.5.0",
    "passport": "^0.5.2",
    "passport-custom": "^1.1.1",
    "passport-headerapikey": "^1.2.2",
    "passport-local": "^1.0.0",
    "pg": "^8.6.0",
    "r-integration": "^2.3.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^6.6.6",
    "swagger-ui-express": "^4.1.6",
    "typeorm": "^0.2.34",
    "winston": "^3.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.13",
    "@nestjs/cli": "^7.6.0",
    "@nestjs/schematics": "^7.3.0",
    "@nestjs/testing": "^7.6.15",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.11",
    "@types/jest": "^26.0.22",
    "@types/lodash": "^4.14.176",
    "@types/node": "^14.18.2",
    "@types/supertest": "^2.0.10",
    "@types/validator": "^13.7.1",
    "@types/webpack": "^5.28.0",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "cross-env": "^7.0.3",
    "eslint": "^7.22.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "husky": "^7.0.1",
    "jest": "^26.6.3",
    "prettier": "^2.2.1",
    "supertest": "^6.1.3",
    "ts-jest": "^26.5.4",
    "ts-loader": "^8.0.18",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.2.3",
    "webpack": "^5.42.0",
    "webpack-cli": "^4.7.2",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@common-request-dto/(.*)$": "<rootDir>/common/dto/request/$1",
      "^@common-response-dto/(.*)$": "<rootDir>/common/dto/response/$1",
      "^@common-request-dto-interfaces/(.*)$": "<rootDir>/shared/dto/request/$1",
      "^@common-response-dto-interfaces/(.*)$": "<rootDir>/shared/dto/response/$1",
      "^@common-types-dto/(.*)$": "<rootDir>/common/dto/types/$1",
      "^@common-types/(.*)$": "<rootDir>/shared/types/$1",
      "^@common-enums/(.*)$": "<rootDir>/shared/enums/$1",
      "^@common-interfaces/(.*)$": "<rootDir>/common/interfaces/$1",
      "^@common-utils/(.*)$": "<rootDir>/common/utils/$1",
      "^@common-config/(.*)$": "<rootDir>/common/config/$1",
      "^@custom-decorators/(.*)$": "<rootDir>/decorators/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --quiet"
    ]
  }
}
